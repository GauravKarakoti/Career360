{
    "name": "career360",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --hostname 0.0.0.0 --port 3000",
        "build": "prisma generate && next build",
        "start": "next start --hostname 0.0.0.0 --port 3000",
        "db:gen": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:migrate:prod": "node scripts/database.mjs migrate",
        "typecheck": "tsc --noEmit",
        "test:privacy": "node --experimental-strip-types --no-warnings scripts/check-profile-privacy.mjs",
        "postinstall": "npm run db:gen"
    },
    "dependencies": {
        "@prisma/client": "6.19.3",
        "dotenv": "^18.0.10",
        "lucide-react": "^0.468.0",
        "next": "16.4.6",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.0.0",
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "prisma": "6.19.3",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.0"
    }
}
